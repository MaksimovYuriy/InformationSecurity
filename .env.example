# This file is a template. The application reads process environment variables.
CLOUD_AUDIT_ENV=development
CLOUD_AUDIT_LOG_LEVEL=INFO
CLOUD_AUDIT_STATE_DIR=.state

# VK Cloud S3: live --profile vk commands and staged scan.
# scan accepts no credentials for unsigned-only checks; supply both keys for the internal stage.
# Copy the relevant fields into your existing .env; do not overwrite your keys.
CLOUD_AUDIT_S3_ENDPOINT_URL=https://hb.ru-msk.vkcloud-storage.ru
# Signing region; independent of the physical location of your buckets.
CLOUD_AUDIT_S3_REGION=us-east-1
# Connection settings are shared by all buckets accessible to these credentials.
# Select targets with audit --resource or scan --buckets/--targets/--all-buckets.

# Fill these only in your local .env. Never commit or share actual credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
